{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gert-vscode: install dependencies",
      "type": "process",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\ensure-npm-deps.ps1",
          "-ExtensionRoot",
          "${workspaceFolder}"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/ensure-npm-deps.sh",
          "${workspaceFolder}"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/ensure-npm-deps.sh",
          "${workspaceFolder}"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "gert-vscode: compile",
      "type": "shell",
      "command": "npm run compile",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "gert-vscode: install dependencies",
      "dependsOrder": "sequence",
      "problemMatcher": "$tsc"
    },
    {
      "label": "gert-vscode: build CLI",
      "type": "process",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\build-cli.ps1",
          "-ExtensionRoot",
          "${workspaceFolder}"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/build-cli.sh",
          "${workspaceFolder}"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/build-cli.sh",
          "${workspaceFolder}"
        ]
      },
      "problemMatcher": "$go"
    },
    {
      "label": "gert-vscode: prepare debug",
      "dependsOn": [
        "gert-vscode: compile",
        "gert-vscode: build CLI"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}

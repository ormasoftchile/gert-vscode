{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gert-vscode: compile",
      "type": "shell",
      "command": "npm run compile",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "gert-vscode: build CLI",
      "type": "process",
      "command": "go",
      "args": [
        "build",
        "-o",
        "gert.exe",
        "./cmd/gert"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../gert"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "gert-vscode: prepare debug",
      "dependsOn": [
        "gert-vscode: compile",
        "gert-vscode: build CLI"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
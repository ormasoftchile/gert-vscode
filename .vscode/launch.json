{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug gert Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "windows": {
        "env": {
          "PATH": "${workspaceFolder}\\..\\gert;${env:PATH}"
        }
      },
      "osx": {
        "env": {
          "PATH": "${workspaceFolder}/../gert:${env:PATH}"
        }
      },
      "linux": {
        "env": {
          "PATH": "${workspaceFolder}/../gert:${env:PATH}"
        }
      },
      "preLaunchTask": "gert-vscode: prepare debug"
    }
  ]
}